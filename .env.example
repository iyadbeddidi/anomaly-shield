# AnomalyShield - Configuration de l'alerting
# Copier ce fichier en `.env` puis adapter les valeurs.

# Seuil de detection (score >= seuil -> alerte)
ANOMALY_THRESHOLD=0.5

# Fichier de log des alertes
ALERT_LOG_FILE=logs/alerts.log

# --- SMTP (optionnel) ---
# Si SMTP_HOST n'est pas configure, les alertes sont uniquement ecrites dans le log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
